{
  "name": "SGAP 2026",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.pixi/envs/default/bin/python"
      },
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"]
    },
    "codespaces": {
      "openFiles": ["content/notebooks/01_evaluation.ipynb"]
    }
  },
  "mounts": [
    "source=${localWorkspaceFolderBasename}-pixi,target=${containerWorkspaceFolder}/.pixi,type=volume"
  ],
  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": {
      "label": "JupyterLab",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "sudo chown vscode .pixi && pixi install && pixi run convert-to-notebooks",
  "postStartCommand": "pixi run jupyter lab --ip=0.0.0.0 --port=8888 --no-browser --ServerApp.token= --ServerApp.password= --ServerApp.allow_origin=*"
}
