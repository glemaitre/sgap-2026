{
  "name": "SGAP 2026",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.pixi/envs/default/bin/python"
      },
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"]
    },
    "codespaces": {
      "openFiles": ["sessions/agentic-ml/README.md"]
    }
  },
  "mounts": [
    "source=${localWorkspaceFolderBasename}-pixi,target=${containerWorkspaceFolder}/.pixi,type=volume"
  ],
  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": {
      "label": "JupyterLab",
      "onAutoForward": "openBrowser"
    }
  },
  "remoteEnv": {
    "OPENROUTER_API_KEY": "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"
  },
  "postCreateCommand": "sudo chown vscode .pixi && pixi install && pixi run convert-to-notebooks && cd sessions/agentic-ml && pixi run skore skills install all --agent pi",
  "postStartCommand": "pixi run jupyter lab --ip=0.0.0.0 --port=8888 --no-browser --ServerApp.token= --ServerApp.password= --ServerApp.allow_origin=*"
}
