{
  "name": "SGAP 2026",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.pixi/envs/default/bin/python",
        "python.envFile": "${workspaceFolder}/sessions/agentic-ml/.env",
        "python.terminal.useEnvFile": true,
        "security.workspace.trust.enabled": false
      },
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"]
    },
    "codespaces": {
      "openFiles": ["sessions/agentic-ml/README.md"]
    }
  },
  "mounts": [
    "source=${localWorkspaceFolderBasename}-pixi,target=${containerWorkspaceFolder}/.pixi,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/prepare-pi.sh && sudo chown vscode .pixi && pixi install && pixi run convert-to-notebooks && cd sessions/agentic-ml && pixi run skore skills install all --agent pi"
}
